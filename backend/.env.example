# Supply the connection URL provided by the infrastructure owner.
# Example format only: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=
# Or compose a URL from these local-development values.
POSTGRES_HOST=
POSTGRES_DB=schoolhealth
POSTGRES_USER=schoolhealth
POSTGRES_PASSWORD=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
# Generate a unique signing secret; do not commit the real value.
AUTH_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Ollama Cloud. Keep keys ONLY here on the backend; never use VITE_* secrets.
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=
# Temporary development admin gate (distinct from the Ollama API key).
INSIGHTS_ADMIN_TOKEN=
