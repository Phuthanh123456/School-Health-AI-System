# Supply the connection URL provided by the infrastructure owner.
# Example format only: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Comma-separated frontend origins. Adjust for the frontend dev server/deployment.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate a unique signing secret; do not commit the real value.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-characters
