# Supply the connection URL provided by the infrastructure owner.
# Example format only: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Comma-separated frontend origins. Adjust for the frontend dev server/deployment.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Ollama Cloud. Keep keys ONLY here on the backend; never use VITE_* secrets.
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=
# Temporary development admin gate; use a random token (not the Ollama key).
# Replace require_admin with the shared authenticated Admin role before release.
INSIGHTS_ADMIN_TOKEN=
